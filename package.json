{
  "name": "flop-pool",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype: fixed, fully funded FLOP mining campaigns with simulated USDC, simulated GPU provider, and an auditable reward ledger.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:artifact": "node scripts/build.mjs --artifact",
    "typecheck": "tsc --noEmit",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.mjs",
    "dev": "node scripts/build.mjs && node --disable-warning=ExperimentalWarning dist/server/index.mjs",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.28.2",
    "playwright-core": "1.49.1",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  }
}
